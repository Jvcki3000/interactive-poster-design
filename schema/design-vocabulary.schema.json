            "type": {
              "type": "array",
              "items": {
                "enum": [
                  "paper",
                  "paper_grain",
                  "film_grain",
                  "dust",
                  "noise",
                  "ink_bleed",
                  "screen_print",
                  "risograph",
                  "xerox",
                  "fold",
                  "scratch",
                  "fabric",
                  "metal",
                  "glass",
                  "plastic",
                  "none"
                ]
              }
            },
            "scale": {
              "enum": [
                "fine",
                "medium",
                "coarse",
                "mixed"
              ]
