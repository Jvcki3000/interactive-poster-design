                "fluid",
                "cinematic",
                "chaotic"
              ]
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "speed": {
              "enum": [
                "instant",
                "fast",
                "medium",
                "slow",
                "very_slow"
              ]
            },
            "direction": {
