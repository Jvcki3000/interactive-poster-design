{
  "$comment": "weather-poster: 海报随用户实时天气变化 — 打开即定位城市 → 拉 Open-Meteo 实时天气 → 匹配相位（晴/云/雨/雪/风暴 × 昼夜）+ 雨幕/星空。每个人看到的都不一样。",
  "canvas": { "width": 1080, "height": 1620, "unit": "px", "responsive": true },
  "content": {
    "title": "CITY LIVE",
    "subtitle": "YOUR WEATHER · YOUR POSTER",
    "location": "EVERY VIEWER SEES THEIR OWN SKY",
    "metadata": {
      "brand": "LIVE WEATHER",
      "tag": "PERSONAL POSTER",
      "note": "LOCATION + SKY → UNIQUE POSTER · CLICK CHIP TO REFRESH"
    }
  },
  "style": {
    "colors": {
      "bg": "#101820",
      "surface": "#1c2730",
      "ink": "#e6eef4",
      "accent": "#6f8fa8",
      "accent2": "#b58a4a",
      "muted": "#7d8b96"
    },
    "typography": {
      "fontFamily": "'Arial Narrow', 'Helvetica Neue', Arial, sans-serif",
      "bodyFont": "'Helvetica Neue', Arial, sans-serif",
      "scaleRatio": 1.3,
      "titleScale": 3.0
    },
    "layout": { "gridColumns": 12, "gutter": 24, "margin": 56, "mode": "classic" },
    "weather": {
      "defaultCity": "Singapore",
      "lat": 1.3521,
      "lon": 103.8198,
      "phases": [
        {
          "match": { "group": ["clear"], "isDay": true },
          "name": "SUNNY",
          "label": "CLEAR DAY",
          "colors": { "bg": "#cfe9f5", "surface": "#ffffff", "ink": "#12324a", "accent": "#1b6fb5", "accent2": "#f5a623", "muted": "#4a7186" },
          "fx": { "grain": 0.1, "glow": 0.6, "contrast": 1.15, "brightness": 1.03, "saturate": 1.15, "shadow": 0.3 }
        },
        {
          "match": { "group": ["clear"], "isDay": false },
          "name": "STARRY",
          "label": "CLEAR NIGHT",
          "colors": { "bg": "#0a1226", "surface": "#16233f", "ink": "#e8f0ff", "accent": "#7db8ff", "accent2": "#ffd76e", "muted": "#8fa3c0" },
          "fx": { "grain": 0.2, "glow": 0.8, "stars": 1, "contrast": 1.1, "brightness": 0.95, "saturate": 1.05, "shadow": 0.8 }
        },
        {
          "match": { "group": ["cloud", "fog"] },
          "name": "CLOUDY",
          "label": "CLOUDY / FOG",
          "colors": { "bg": "#9fb3c2", "surface": "#c4d2dc", "ink": "#1c2733", "accent": "#5a7386", "accent2": "#c8a24a", "muted": "#3f5465" },
          "fx": { "grain": 0.25, "glow": 0.5, "contrast": 1, "brightness": 1, "saturate": 0.8, "shadow": 0.5 }
        },
        {
          "match": { "group": ["drizzle", "rain"] },
          "name": "RAINY",
          "label": "RAIN",
          "colors": { "bg": "#26323e", "surface": "#344450", "ink": "#e8f1f7", "accent": "#6fa8cc", "accent2": "#8fb7d1", "muted": "#9db3c2" },
          "fx": { "grain": 0.3, "glow": 0.4, "rain": 1, "rainDensity": 0.9, "fog": 0.6, "blur": 0.12, "contrast": 1.05, "brightness": 0.92, "saturate": 0.85, "shadow": 0.7 }
        },
        {
          "match": { "group": ["storm"] },
          "name": "STORM",
          "label": "THUNDERSTORM",
          "colors": { "bg": "#0b0f14", "surface": "#161d26", "ink": "#dde8ef", "accent": "#b8d9f0", "accent2": "#ffe066", "muted": "#7f8b96" },
          "fx": { "grain": 0.4, "glow": 1.8, "rain": 1, "rainDensity": 2, "fog": 0.85, "contrast": 1.3, "brightness": 0.85, "saturate": 0.9, "shadow": 0.9 }
        },
        {
          "match": { "group": ["snow"] },
          "name": "SNOWY",
          "label": "SNOW",
          "colors": { "bg": "#dbe7ee", "surface": "#f0f6fa", "ink": "#22384a", "accent": "#7fb3d9", "accent2": "#a9c6dd", "muted": "#5d7487" },
          "fx": { "grain": 0.15, "glow": 0.7, "blur": 0.05, "contrast": 1.05, "brightness": 1.05, "saturate": 0.75, "shadow": 0.35 }
        },
        {
          "name": "NEUTRAL",
          "label": "OFFLINE FALLBACK",
          "colors": { "bg": "#101820", "surface": "#1c2730", "ink": "#e6eef4", "accent": "#6f8fa8", "accent2": "#b58a4a", "muted": "#7d8b96" },
          "fx": { "grain": 0.3, "glow": 0.6, "contrast": 1, "brightness": 1, "saturate": 1, "shadow": 0.6 }
        }
      ]
    }
  },
  "animation": {
    "title": { "reveal": "chars", "stagger": 0.06 },
    "scroll": { "reveal": true }
  },
  "interactions": {
    "background": { "type": "parallax", "depth": 0.1 },
    "glow": { "type": "cursorLight", "blend": "screen" },
    "title": { "type": "hover", "effect": "distort" }
  },
  "assets": []
}
